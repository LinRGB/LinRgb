pkgname=linrgb
pkgver=1.0.0beta.2
pkgrel=1
_version=1.0.0-beta.2
pkgdesc='Native RGB lighting control for Linux'
arch=('x86_64')
url='https://github.com/LinRGB/LinRgb'
license=('LicenseRef-NotDeclared')
depends=('gtk4' 'systemd-libs')
makedepends=('rust' 'pkgconf' 'systemd')
source=("$url/releases/download/v$_version/$pkgname-$_version.tar.gz")
sha256sums=('62cb37880cc77087c17f2d774c2645981cf5bae5ecd8f054e1305f4e8906161c')

prepare() {
  cd "$srcdir/$pkgname-$_version"
  CARGO_HOME="$srcdir/cargo-home" cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}
build() {
  cd "$srcdir/$pkgname-$_version"
  CARGO_HOME="$srcdir/cargo-home" cargo build --frozen --release --target "$CARCH-unknown-linux-gnu"
}
check() {
  cd "$srcdir/$pkgname-$_version"
  CARGO_HOME="$srcdir/cargo-home" cargo test --frozen --release --target "$CARCH-unknown-linux-gnu"
}
package() {
  cd "$srcdir/$pkgname-$_version"
  install -Dm755 "target/$CARCH-unknown-linux-gnu/release/linrgb" "$pkgdir/usr/bin/linrgb"
  install -Dm644 packaging/io.github.linrgb.LinRgb.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/io.github.linrgb.LinRgb.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 packaging/70-linrgb.rules -t "$pkgdir/usr/lib/udev/rules.d"
  install -Dm644 notices/* -t "$pkgdir/usr/share/doc/linrgb"
  install -d "$pkgdir/usr/lib/modules-load.d"
  printf 'i2c-dev\n' > "$pkgdir/usr/lib/modules-load.d/linrgb.conf"
}
