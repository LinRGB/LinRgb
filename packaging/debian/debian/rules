#!/usr/bin/make -f

CARGO = rustup run 1.99.1 cargo

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	$(CARGO) fetch --locked --target x86_64-unknown-linux-gnu
	$(CARGO) build --frozen --release --target x86_64-unknown-linux-gnu

override_dh_auto_test:
	$(CARGO) test --frozen --release --target x86_64-unknown-linux-gnu

override_dh_auto_install:
	install -Dm644 -t debian/linrgb/usr/share/doc/linrgb notices/*
	install -Dm755 target/x86_64-unknown-linux-gnu/release/linrgb debian/linrgb/usr/bin/linrgb
	install -Dm644 packaging/io.github.linrgb.LinRgb.desktop -t debian/linrgb/usr/share/applications
	install -Dm644 packaging/io.github.linrgb.LinRgb.svg -t debian/linrgb/usr/share/icons/hicolor/scalable/apps
	install -Dm644 packaging/70-linrgb.rules -t debian/linrgb/usr/lib/udev/rules.d
	install -d debian/linrgb/usr/lib/modules-load.d
	printf 'i2c-dev\n' > debian/linrgb/usr/lib/modules-load.d/linrgb.conf
